/* Global canvas and dialogs share one quiet desktop-app palette. */
QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background: #F3F6FA;
    color: #253042;
}

QWidget {
    color: #253042;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel {
    color: #5B687A;
}

QLabel#mutedLabel {
    color: #8491A3;
}

QToolTip {
    background: #FCFDFE;
    color: #253042;
    border: 1px solid #DCE5EF;
    border-radius: 8px;
    padding: 6px 9px;
}

QMenuBar {
    background: #FCFDFE;
    color: #425166;
    border-bottom: 1px solid #E5EAF1;
    padding: 3px 8px;
}

QMenuBar::item {
    background: transparent;
    border-radius: 6px;
    padding: 6px 9px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: #E8F2FF;
    color: #2F78BE;
}

QMenu {
    background: #FCFDFE;
    color: #253042;
    border: 1px solid #DCE5EF;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    border-radius: 6px;
    padding: 6px 22px 6px 12px;
}

/* Preserve non-native QFileDialog browser readability without direct view selectors. */
QFileDialog QLineEdit,
QFileDialog QPushButton,
QFileDialog QComboBox {
    background: #FFFFFF;
    color: #253042;
}

QFileDialog QAbstractScrollArea,
QFileDialog QAbstractScrollArea::viewport,
QFileDialog QAbstractItemView {
    background: #FFFFFF;
    color: #253042;
}

QFileDialog QAbstractItemView {
    border: 1px solid #DCE5EF;
    outline: 0;
    selection-background-color: #E8F2FF;
    selection-color: #253042;
}

QFileDialog QAbstractItemView::item {
    color: #253042;
    padding: 3px 6px;
}

QFileDialog QAbstractItemView::item:selected {
    background: #E8F2FF;
    color: #253042;
}

QGroupBox {
    background: #FCFDFE;
    border: 1px solid #E5EAF1;
    border-radius: 12px;
    margin-top: 12px;
    padding: 12px;
    color: #253042;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #253042;
}

QGroupBox#toolbarCard,
QGroupBox#videoCard,
QGroupBox#annotationCard,
QGroupBox#taskCard {
    background: #FCFDFE;
    border: 1px solid #E3EAF2;
    border-radius: 14px;
    margin-top: 14px;
    padding: 16px;
}

QGroupBox#toolbarCard::title,
QGroupBox#videoCard::title,
QGroupBox#annotationCard::title,
QGroupBox#taskCard::title {
    left: 16px;
    color: #253042;
    font-size: 14px;
    font-weight: 700;
}

QWidget#importActionGroup,
QWidget#csvActionGroup,
QWidget#exportActionGroup,
QWidget#settingsActionGroup {
    background: #F8FBFE;
    border: 1px solid #E4EBF3;
    border-radius: 10px;
}

QLabel#toolbarGroupCaption {
    color: #8491A3;
    font-size: 11px;
    font-weight: 700;
}

QFrame#toolbarSeparator {
    min-width: 1px;
    max-width: 1px;
    background: #E3EAF2;
    margin: 10px 7px;
}

QGroupBox#inlineExportOptions {
    background: #F7FAFD;
    border: 1px solid #DCE8F4;
    border-radius: 10px;
    margin-top: 10px;
    padding: 10px;
}

QScrollArea#mainContentScroll,
QWidget#workspaceContent {
    background: #F3F6FA;
    border: 0;
}

QScrollArea {
    background: #FCFDFE;
    border: 1px solid #E5EAF1;
    border-radius: 10px;
}

QPushButton {
    min-height: 32px;
    padding: 5px 12px;
    background: #FCFDFE;
    border: 1px solid #DCE5EF;
    border-radius: 9px;
    color: #425166;
}

QPushButton:hover {
    background: #F0F7FF;
    border-color: #A7CCF2;
    color: #2F78BE;
}

QPushButton:focus {
    border-color: #4F97E8;
}

QPushButton:pressed {
    background: #E2F0FF;
    border-color: #4F97E8;
}

QPushButton:disabled {
    background: #F4F7FA;
    border-color: #E5EAF1;
    color: #A3AFBE;
}

QPushButton#primaryButton,
QPushButton#addClipButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #63A7ED, stop: 1 #438DDD
    );
    border-color: #438DDD;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#primaryButton:hover,
QPushButton#addClipButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #75B4F1, stop: 1 #4F97E8
    );
    border-color: #4F97E8;
    color: #FFFFFF;
}

QPushButton#primaryButton:pressed,
QPushButton#addClipButton:pressed {
    background: #397FC7;
    border-color: #397FC7;
}

QPushButton#undoButton,
QPushButton#redoButton,
QPushButton#secondaryButton {
    background: #F2F8FE;
    border-color: #C9DEF4;
    color: #397FC7;
}

QPushButton#undoButton:hover,
QPushButton#redoButton:hover,
QPushButton#secondaryButton:hover {
    background: #E8F3FF;
    border-color: #8FC0EE;
}

QPushButton#dangerButton {
    background: #FFF9F8;
    border-color: #F1CBC7;
    color: #C75B55;
}

QPushButton#dangerButton:hover {
    background: #FFF0EE;
    border-color: #E59A93;
    color: #B94E48;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 30px;
    padding: 3px 9px;
    background: #FFFFFF;
    border: 1px solid #D7E1EC;
    border-radius: 8px;
    color: #253042;
    selection-background-color: #CFE6FF;
    selection-color: #253042;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #B6D4F0;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #4F97E8;
    background: #FCFEFF;
}

QLineEdit:read-only {
    background: #F5F8FB;
    color: #77869A;
}

QDoubleSpinBox#customPlaybackRateSpin {
    min-width: 88px;
}

QComboBox#projectVideoCombo {
    background: #FFFFFF;
    border-color: #D7E1EC;
    color: #253042;
}

QComboBox::drop-down {
    width: 25px;
    border: 0;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DCE5EF;
    border-radius: 8px;
    color: #253042;
    outline: 0;
    selection-background-color: #E8F2FF;
    selection-color: #253042;
}

QComboBox QAbstractItemView::item {
    min-height: 29px;
    padding: 3px 9px;
}

QCheckBox {
    color: #5B687A;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background: #FFFFFF;
    border: 1px solid #B8C6D6;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #4F97E8;
}

QCheckBox::indicator:checked {
    background: #4F97E8;
    border-color: #4F97E8;
}

QGroupBox#collapsibleBehaviorGroup {
    background: #F8FBFE;
    border-color: #DCE8F4;
    border-radius: 11px;
}

QGroupBox#collapsibleBehaviorGroup::indicator {
    width: 0;
    height: 0;
}

QGroupBox#collapsibleBehaviorGroup::title {
    left: 26px;
    color: #397FC7;
}

QCheckBox#behaviorTag {
    min-height: 24px;
    padding: 5px 10px;
    background: #FFFFFF;
    border: 1px solid #DCE5EF;
    border-radius: 12px;
    color: #425166;
}

QCheckBox#behaviorTag:hover {
    background: #F3F9FF;
    border-color: #A7CCF2;
    color: #2F78BE;
}

QCheckBox#behaviorTag:focus {
    border-color: #4F97E8;
}

QCheckBox#behaviorTag:checked {
    background: #E8F2FF;
    border-color: #8FC0EE;
    color: #2F78BE;
    font-weight: 600;
}

QCheckBox#behaviorTag::indicator {
    width: 0;
    height: 0;
    border: 0;
}

QScrollBar:vertical {
    width: 10px;
    margin: 4px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #C2D0DE;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #91BEE7;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 4px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #C2D0DE;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #91BEE7;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QWidget#tableFilterBar,
QWidget#tableActionBar {
    background: #F7FAFD;
    border: 1px solid #E3EAF2;
    border-radius: 10px;
}

QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F8FBFE;
    color: #253042;
    gridline-color: #E8EDF3;
    selection-background-color: #E8F2FF;
    selection-color: #253042;
    border: 1px solid #DCE5EF;
    border-radius: 10px;
}

QTableWidget::item {
    padding: 6px 9px;
    border-bottom: 1px solid #EEF2F6;
}

QTableWidget::item:alternate {
    background: #F8FBFE;
}

QTableWidget::item:selected {
    background: #E8F2FF;
    color: #253042;
}

QHeaderView::section {
    min-height: 30px;
    background: #F1F6FB;
    color: #536278;
    border: 0;
    border-right: 1px solid #E3EAF2;
    border-bottom: 1px solid #DCE5EF;
    padding: 7px 9px;
    font-weight: 700;
}

QSlider::groove:horizontal {
    height: 7px;
    background: #DCE6F0;
    border-radius: 4px;
}

QSlider::sub-page:horizontal {
    background: #4F97E8;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    width: 15px;
    margin: -5px 0;
    background: #FFFFFF;
    border: 3px solid #4F97E8;
    border-radius: 8px;
}

QProgressBar {
    min-height: 22px;
    background: #FFFFFF;
    border: 1px solid #DCE5EF;
    border-radius: 8px;
    color: #5B687A;
    text-align: center;
}

QProgressBar::chunk {
    background: #4F97E8;
    border-radius: 7px;
}

QSplitter::handle {
    background: #E7EDF3;
}

QSplitter::handle:hover {
    background: #CFE6FF;
}

QDialogButtonBox {
    border-top: 1px solid #E5EAF1;
    padding-top: 10px;
}

QGraphicsView#videoSurface,
QGraphicsView#videoSurface::viewport {
    background: #141D2B;
    border: 1px solid #D7E2EE;
    border-radius: 12px;
}

QWidget#videoControlsPanel {
    background: #F7FBFF;
    border: 1px solid #D4E5F5;
    border-radius: 12px;
}

QLabel#playbackRateBadge {
    min-width: 42px;
    padding: 5px 8px;
    background: #E8F5F3;
    border: 1px solid #BFE1DB;
    border-radius: 9px;
    color: #167D75;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}
