QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background: #F5F7FA;
    color: #303133;
}

QFileDialog QLineEdit,
QFileDialog QPushButton,
QFileDialog QComboBox {
    background: #FFFFFF;
    color: #303133;
}

QWidget {
    color: #303133;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel {
    color: #606266;
}

QToolTip {
    background: #FFFFFF;
    color: #303133;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 5px 7px;
}

QGroupBox {
    background: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px;
    color: #303133;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #303133;
}

QGroupBox#collapsibleBehaviorGroup::indicator {
    width: 0px;
    height: 0px;
}

QGroupBox#collapsibleBehaviorGroup::title {
    left: 26px;
}

QPushButton {
    min-height: 30px;
    padding: 4px 12px;
    background: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 6px;
    color: #303133;
}

QPushButton:hover {
    background: #ECF5FF;
    border-color: #A0CFFF;
    color: #409EFF;
}

QPushButton:focus {
    border-color: #409EFF;
}

QPushButton:pressed {
    background: #D9ECFF;
    border-color: #409EFF;
}

QPushButton:disabled {
    background: #F5F7FA;
    border-color: #EBEEF5;
    color: #C0C4CC;
}

QPushButton#primaryButton, QPushButton#addClipButton {
    background: #409EFF;
    border-color: #409EFF;
    color: #FFFFFF;
}

QPushButton#undoButton,
QPushButton#redoButton {
    background: #FFFFFF;
    border-color: #DCDFE6;
    color: #409EFF;
}

QPushButton#undoButton:hover,
QPushButton#redoButton:hover {
    background: #ECF5FF;
    border-color: #A0CFFF;
}

QComboBox#projectVideoCombo {
    background: #FFFFFF;
    border-color: #DCDFE6;
    color: #303133;
}

QPushButton#primaryButton:hover, QPushButton#addClipButton:hover {
    background: #66B1FF;
    border-color: #66B1FF;
    color: #FFFFFF;
}

QPushButton#primaryButton:pressed, QPushButton#addClipButton:pressed {
    background: #337ECC;
    border-color: #337ECC;
}

QPushButton#dangerButton {
    background: #FFFFFF;
    border-color: #FBC4C4;
    color: #F56C6C;
}

QPushButton#dangerButton:hover {
    background: #FEF0F0;
    border-color: #F89898;
    color: #F56C6C;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    min-height: 28px;
    padding: 2px 8px;
    background: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 6px;
    color: #303133;
    selection-background-color: #C6E2FF;
    selection-color: #303133;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #409EFF;
}

QLineEdit:read-only {
    background: #F5F7FA;
    color: #909399;
}

QComboBox::drop-down {
    width: 24px;
    border: 0;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DCDFE6;
    color: #303133;
    outline: 0;
    selection-background-color: #ECF5FF;
    selection-color: #303133;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 3px 8px;
}

QCheckBox {
    color: #606266;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background: #FFFFFF;
    border: 1px solid #C0C4CC;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #409EFF;
}

QCheckBox::indicator:checked {
    background: #409EFF;
    border-color: #409EFF;
}

QScrollArea {
    background: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 8px;
}

QScrollBar:vertical {
    width: 10px;
    margin: 3px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #C0C4CC;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #A0CFFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 3px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #C0C4CC;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #A0CFFF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QTableWidget {
    background: #FFFFFF;
    color: #303133;
    gridline-color: #EBEEF5;
    selection-background-color: #ECF5FF;
    selection-color: #303133;
    border: 1px solid #DCDFE6;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 4px 7px;
}

QTableWidget::item:selected {
    background: #ECF5FF;
    color: #303133;
}

QHeaderView::section {
    background: #F5F7FA;
    color: #606266;
    border: 0;
    border-right: 1px solid #EBEEF5;
    border-bottom: 1px solid #DCDFE6;
    padding: 6px;
    font-weight: 600;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #DCDFE6;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #409EFF;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -4px 0;
    background: #FFFFFF;
    border: 2px solid #409EFF;
    border-radius: 7px;
}

QProgressBar {
    min-height: 20px;
    background: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 6px;
    color: #606266;
    text-align: center;
}

QProgressBar::chunk {
    background: #409EFF;
    border-radius: 5px;
}

QSplitter::handle {
    background: #EBEEF5;
}

QSplitter::handle:hover {
    background: #D9ECFF;
}

QDialogButtonBox {
    border-top: 1px solid #EBEEF5;
    padding-top: 10px;
}

QLabel#mutedLabel {
    color: #909399;
}

QWidget#videoSurface {
    background: #1F2937;
    border: 1px solid #DCDFE6;
    border-radius: 6px;
}
