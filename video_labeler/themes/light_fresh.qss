/* Ant Design Desktop light theme shared by windows, dialogs, and tooltips. */
QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background: #f7f8fa;
    color: #1f2329;
}

QWidget {
    color: #1f2329;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel {
    color: #4e5969;
}

QLabel#mutedLabel {
    color: #86909c;
}

QToolTip {
    background: #ffffff;
    color: #1f2329;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    padding: 6px 9px;
}

QMenuBar, QMenu {
    background: #ffffff;
    color: #1f2329;
    border: 0;
}

QMenuBar {
    border-bottom: 1px solid #e5e6eb;
    padding: 3px 8px;
}

QMenu {
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    padding: 4px;
}

QMenuBar::item, QMenu::item {
    background: transparent;
    border-radius: 8px;
    padding: 6px 10px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: #e8f3ff;
    color: #1677ff;
}

/* Keep non-native file browser lists readable without direct view selectors. */
QFileDialog QLineEdit,
QFileDialog QPushButton,
QFileDialog QComboBox {
    background: #ffffff;
    color: #1f2329;
}

QFileDialog QAbstractScrollArea,
QFileDialog QAbstractScrollArea::viewport,
QFileDialog QAbstractItemView {
    background: #ffffff;
    color: #1f2329;
}

QFileDialog QAbstractItemView {
    border: 1px solid #e5e6eb;
    outline: 0;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
}

QFileDialog QAbstractItemView::item {
    color: #1f2329;
    padding: 3px 6px;
}

QFileDialog QAbstractItemView::item:selected {
    background: #e8f3ff;
    color: #1f2329;
}

QScrollArea#mainContentScroll,
QWidget#workspaceContent {
    background: #f7f8fa;
    border: 0;
}

QWidget#workspaceContent,
QWidget#workspaceRow,
QWidget#annotationWorkspace {
    background: #f7f8fa;
}

QWidget#workspaceRow {
    border: 0;
}

QScrollArea {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    color: #1f2329;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #1f2329;
}

QGroupBox#toolbarCard,
QGroupBox#videoCard,
QGroupBox#annotationCard,
QGroupBox#taskCard {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
}

QGroupBox#toolbarCard::title,
QGroupBox#videoCard::title,
QGroupBox#annotationCard::title,
QGroupBox#taskCard::title {
    color: #1f2329;
    font-size: 14px;
    font-weight: 700;
}

QGroupBox#toolbarCard {
    padding: 10px;
}

QWidget#importCsvActionGroup,
QWidget#exportOutputActionGroup,
QWidget#settingsOperationActionGroup {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QLabel#toolbarGroupCaption {
    color: #86909c;
    font-size: 11px;
    font-weight: 700;
}

QFrame#toolbarSeparator {
    min-width: 1px;
    max-width: 1px;
    background: #e5e6eb;
    margin: 10px 7px;
}

QGroupBox#inlineExportOptions {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px;
}

QPushButton {
    min-height: 32px;
    padding: 5px 12px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #4e5969;
}

QPushButton:hover {
    background: #e8f3ff;
    border-color: #4096ff;
    color: #1677ff;
}

QPushButton:focus {
    border-color: #1677ff;
}

QPushButton:pressed {
    background: #d9ecff;
    border-color: #1677ff;
}

QPushButton:disabled {
    background: #f2f3f5;
    border-color: #e5e6eb;
    color: #86909c;
}

QPushButton#primaryButton,
QPushButton#addClipButton {
    background: #1677ff;
    border-color: #1677ff;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:hover,
QPushButton#addClipButton:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
}
QPushButton#primaryButton:pressed,
QPushButton#addClipButton:pressed {
    background: #1e40af;
    border-color: #1e40af;
    padding-top: 8px;
}
QPushButton#primaryButton:disabled,
QPushButton#addClipButton:disabled {
    background: #bfdbfe;
    border-color: #bfdbfe;
    color: #eff6ff;
}
QPushButton#secondaryButton:hover,
QPushButton#undoButton:hover,
QPushButton#redoButton:hover {
    background: #e0f2fe;
    border-color: #38bdf8;
    color: #0369a1;
}

QPushButton#dangerButton {
    background: #ff7875;
    border-color: #ff7875;
    color: #ffffff;
}

QPushButton#dangerButton:hover {
    background: #ff9c99;
    border-color: #ff9c99;
    color: #ffffff;
}

QPushButton#undoButton,
QPushButton#redoButton,
QPushButton#secondaryButton {
    background: #f2f3f5;
    border-color: #e5e6eb;
    color: #4e5969;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 30px;
    padding: 3px 9px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1f2329;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #4096ff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #1677ff;
}

QLineEdit:read-only {
    background: #f2f3f5;
    color: #86909c;
}

QDoubleSpinBox#customPlaybackRateSpin {
    min-width: 88px;
}

QComboBox::drop-down {
    width: 25px;
    border: 0;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1f2329;
    outline: 0;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
}

QComboBox QAbstractItemView::item {
    min-height: 29px;
    padding: 6px 10px;
}
QScrollBar:vertical {
    width: 10px;
    margin: 3px 1px 3px 1px;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 42px;
    border-radius: 5px;
    background: #cbd5e1;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; border: 0; }

QCheckBox {
    color: #4e5969;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background: #1677ff;
    border-color: #1677ff;
}

QGroupBox#collapsibleBehaviorGroup {
    background: #ffffff;
    border-color: #e5e6eb;
}

QGroupBox#collapsibleBehaviorGroup::indicator {
    width: 0;
    height: 0;
}

QComboBox#behaviorTagCombo,
QComboBox#customTagLibraryCombo {
    min-height: 32px;
    padding: 4px 10px;
    background: #e8f3ff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1677ff;
}

QComboBox#behaviorTagCombo:hover,
QComboBox#customTagLibraryCombo:hover {
    border-color: #4096ff;
}

QComboBox#behaviorTagCombo QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 10px;
}

QLabel#historicalBehaviorTag {
    min-height: 24px;
    padding: 5px 10px;
    background: #f2f3f5;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #86909c;
}

QScrollBar:vertical {
    width: 8px;
    margin: 4px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #c9cdd4;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #a9aeb8;
}

QScrollBar:horizontal {
    height: 8px;
    margin: 4px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #c9cdd4;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #a9aeb8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QWidget#tableFilterBar,
QWidget#tableActionBar,
QWidget#videoControlsPanel,
QWidget#tableSearchRow {
    background: #f8fafc;
    border: 1px solid #dbe4ef;
    border-radius: 11px;
}
QWidget#tableActionBar QPushButton {
    min-height: 36px;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f7f8fa;
    color: #1f2329;
    gridline-color: #e5e6eb;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 6px 9px;
    border-bottom: 1px solid #f2f3f5;
}

QTableWidget::item:alternate {
    background: #f7f8fa;
}

QTableWidget::item:selected {
    background: #e8f3ff;
    color: #1f2329;
}

QHeaderView::section {
    min-height: 30px;
    background: #f2f3f5;
    color: #4e5969;
    border: 0;
    border-right: 1px solid #e5e6eb;
    border-bottom: 1px solid #e5e6eb;
    padding: 7px 9px;
    font-weight: 700;
}

QSlider::groove:horizontal {
    height: 9px;
    background: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
}

QSlider::sub-page:horizontal,
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #06b6d4);
    border-radius: 5px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background: #ffffff;
    border: 3px solid #1677ff;
    border-radius: 8px;
}

QProgressBar {
    min-height: 22px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #4e5969;
    text-align: center;
}

QSplitter::handle {
    background: #e5e6eb;
}

QSplitter::handle:hover {
    background: #e8f3ff;
}

QDialogButtonBox {
    border-top: 1px solid #e5e6eb;
    padding-top: 10px;
}

QGraphicsView#videoSurface,
QGraphicsView#videoSurface::viewport {
    background: #1f2329;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QLabel#playbackRateBadge {
    min-width: 42px;
    padding: 5px 8px;
    background: #e8f3ff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1677ff;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

/* Premium workspace refresh: layered surfaces, stronger hierarchy, calmer density. */
QWidget#projectHero {
    min-height: 58px;
    padding: 4px 6px;
    background: transparent;
}
QLabel#heroMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2563eb, stop:1 #7c3aed);
    border: 1px solid #93c5fd;
    border-radius: 14px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 900;
    qproperty-alignment: AlignCenter;
}
QLabel#heroTitle {
    color: #0f172a;
    font-size: 21px;
    font-weight: 900;
}
QLabel#heroSubtitle {
    color: #64748b;
    font-size: 11px;
    letter-spacing: 0.5px;
}
QWidget#videoInfoPanel {
    background: #f8fafc;
    border: 1px solid #dbe4ef;
    border-radius: 11px;
}
QLabel#videoInfoTitle {
    color: #0f172a;
    font-size: 13px;
    font-weight: 800;
}
QLabel#videoInfoMeta {
    color: #64748b;
    font-size: 11px;
}
QLabel#workspaceStatusBadge {
    padding: 6px 12px;
    border: 1px solid #bbf7d0;
    border-radius: 999px;
    background: #f0fdf4;
    color: #15803d;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
}
QMainWindow {
    background: #f1f5f9;
}
QMenuBar {
    min-height: 36px;
    padding: 4px 14px;
    background: #0f172a;
    color: #e2e8f0;
    border: 0;
}
QMenuBar::item {
    padding: 7px 12px;
    color: #cbd5e1;
    border-radius: 7px;
}
QMenuBar::item:selected {
    color: #ffffff;
    background: #1e293b;
}
QWidget#workspaceContent,
QWidget#workspaceRow,
QWidget#annotationWorkspace,
QScrollArea#mainContentScroll {
    background: #f1f5f9;
}
QGroupBox#toolbarCard,
QGroupBox#videoCard,
QGroupBox#annotationCard,
QGroupBox#taskCard,
QGroupBox#operationLogPanel {
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 14px;
    padding: 16px;
    margin-top: 18px;
}
QGroupBox#toolbarCard::title,
QGroupBox#videoCard::title,
QGroupBox#annotationCard::title,
QGroupBox#taskCard::title,
QGroupBox#operationLogPanel::title {
    left: 16px;
    padding: 0 8px;
    color: #0f172a;
    background: #ffffff;
    font-size: 15px;
    font-weight: 800;
}
QWidget#importCsvActionGroup,
QWidget#exportOutputActionGroup,
QWidget#settingsOperationActionGroup {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    padding: 5px;
}
QLabel#toolbarGroupCaption {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}
QLabel#mutedLabel {
    color: #64748b;
}
QPushButton {
    min-height: 34px;
    padding: 6px 14px;
    border: 1px solid #d6e0ec;
    border-radius: 9px;
    background: #ffffff;
    color: #334155;
    font-weight: 600;
}
QPushButton:hover {
    background: #eff6ff;
    border-color: #60a5fa;
    color: #2563eb;
}
QPushButton#primaryButton,
QPushButton#addClipButton {
    min-height: 38px;
    padding: 7px 18px;
    border: 0;
    border-radius: 10px;
    background: #2563eb;
    color: #ffffff;
    font-weight: 800;
}
QPushButton#primaryButton:hover,
QPushButton#addClipButton:hover {
    background: #1d4ed8;
    border-color: #1d4ed8;
    padding-top: 6px;
}
QPushButton:pressed {
    background: #dbeafe;
    border-color: #2563eb;
    padding-top: 8px;
}
QPushButton:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
}
QPushButton#primaryButton:pressed,
QPushButton#addClipButton:pressed {
    background: #1e40af;
    border-color: #1e40af;
    padding-top: 9px;
}
QPushButton#primaryButton:disabled,
QPushButton#addClipButton:disabled {
    background: #bfdbfe;
    color: #eff6ff;
}
QPushButton#dangerButton {
    background: #fff1f2;
    border-color: #fecdd3;
    color: #be123c;
}
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QPlainTextEdit, QTextEdit {
    min-height: 34px;
    padding: 5px 10px;
    background: #ffffff;
    border: 1px solid #d6e0ec;
    border-radius: 9px;
    color: #0f172a;
    selection-background-color: #bfdbfe;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 2px solid #60a5fa;
    padding: 4px 9px;
}
QTableWidget, QTreeWidget, QListWidget {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #dbe4ef;
    border-radius: 11px;
    gridline-color: #edf2f7;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
}
QTableWidget::item, QTreeWidget::item, QListWidget::item {
    padding: 7px 8px;
}
QHeaderView::section {
    min-height: 34px;
    background: #f8fafc;
    color: #475569;
    border-bottom: 1px solid #dbe4ef;
    padding: 8px 10px;
    font-weight: 800;
}
QProgressBar {
    min-height: 24px;
    border: 0;
    border-radius: 12px;
    background: #e2e8f0;
    color: #334155;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 12px;
    background: #2563eb;
}
QGraphicsView#videoSurface,
QGraphicsView#videoSurface::viewport {
    background: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 14px;
}
QLabel#playbackRateBadge {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 9px;
    color: #2563eb;
}
QStatusBar {
    background: #0f172a;
    color: #cbd5e1;
    border-top: 1px solid #1e293b;
}
QToolTip {
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 7px 10px;
}

QFrame#annotationOverview {
    background: #f8fafc;
    border: 1px solid #dbe4ef;
    border-left: 3px solid #2563eb;
    border-radius: 10px;
}
QLabel#annotationOverviewTitle {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}
QLabel#annotationOverviewSource {
    color: #0f172a;
    font-size: 13px;
    font-weight: 700;
}
QLabel#annotationMetric {
    min-height: 42px;
    padding: 4px 7px;
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 8px;
    color: #1e40af;
    font-size: 11px;
    font-weight: 700;
}

QLabel#annotationWarning {
    color: #b45309;
    font-size: 11px;
    font-weight: 600;
}
