/* Ant Design Desktop light theme shared by windows, dialogs, and tooltips. */
QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog {
    background: #f7f8fa;
    color: #1f2329;
}

QWidget {
    color: #1f2329;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel {
    color: #4e5969;
}

QLabel#mutedLabel {
    color: #86909c;
}

QToolTip {
    background: #ffffff;
    color: #1f2329;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    padding: 6px 9px;
}

QMenuBar, QMenu {
    background: #ffffff;
    color: #1f2329;
    border: 0;
}

QMenuBar {
    border-bottom: 1px solid #e5e6eb;
    padding: 3px 8px;
}

QMenu {
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    padding: 4px;
}

QMenuBar::item, QMenu::item {
    background: transparent;
    border-radius: 8px;
    padding: 6px 10px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: #e8f3ff;
    color: #1677ff;
}

/* Keep non-native file browser lists readable without direct view selectors. */
QFileDialog QLineEdit,
QFileDialog QPushButton,
QFileDialog QComboBox {
    background: #ffffff;
    color: #1f2329;
}

QFileDialog QAbstractScrollArea,
QFileDialog QAbstractScrollArea::viewport,
QFileDialog QAbstractItemView {
    background: #ffffff;
    color: #1f2329;
}

QFileDialog QAbstractItemView {
    border: 1px solid #e5e6eb;
    outline: 0;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
}

QFileDialog QAbstractItemView::item {
    color: #1f2329;
    padding: 3px 6px;
}

QFileDialog QAbstractItemView::item:selected {
    background: #e8f3ff;
    color: #1f2329;
}

QScrollArea#mainContentScroll,
QWidget#workspaceContent {
    background: #f7f8fa;
    border: 0;
}

QScrollArea {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    color: #1f2329;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #1f2329;
}

QGroupBox#toolbarCard,
QGroupBox#videoCard,
QGroupBox#annotationCard,
QGroupBox#taskCard {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px;
}

QGroupBox#toolbarCard::title,
QGroupBox#videoCard::title,
QGroupBox#annotationCard::title,
QGroupBox#taskCard::title {
    color: #1f2329;
    font-size: 14px;
    font-weight: 700;
}

QWidget#importCsvActionGroup,
QWidget#exportOutputActionGroup,
QWidget#settingsOperationActionGroup {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QLabel#toolbarGroupCaption {
    color: #86909c;
    font-size: 11px;
    font-weight: 700;
}

QFrame#toolbarSeparator {
    min-width: 1px;
    max-width: 1px;
    background: #e5e6eb;
    margin: 10px 7px;
}

QGroupBox#inlineExportOptions {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px;
}

QPushButton {
    min-height: 32px;
    padding: 5px 12px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #4e5969;
}

QPushButton:hover {
    background: #e8f3ff;
    border-color: #4096ff;
    color: #1677ff;
}

QPushButton:focus {
    border-color: #1677ff;
}

QPushButton:pressed {
    background: #d9ecff;
    border-color: #1677ff;
}

QPushButton:disabled {
    background: #f2f3f5;
    border-color: #e5e6eb;
    color: #86909c;
}

QPushButton#primaryButton,
QPushButton#addClipButton {
    background: #1677ff;
    border-color: #1677ff;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:hover,
QPushButton#addClipButton:hover {
    background: #4096ff;
    border-color: #4096ff;
    color: #ffffff;
}

QPushButton#dangerButton {
    background: #ff7875;
    border-color: #ff7875;
    color: #ffffff;
}

QPushButton#dangerButton:hover {
    background: #ff9c99;
    border-color: #ff9c99;
    color: #ffffff;
}

QPushButton#undoButton,
QPushButton#redoButton,
QPushButton#secondaryButton {
    background: #f2f3f5;
    border-color: #e5e6eb;
    color: #4e5969;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 30px;
    padding: 3px 9px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1f2329;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #4096ff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #1677ff;
}

QLineEdit:read-only {
    background: #f2f3f5;
    color: #86909c;
}

QDoubleSpinBox#customPlaybackRateSpin {
    min-width: 88px;
}

QComboBox::drop-down {
    width: 25px;
    border: 0;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1f2329;
    outline: 0;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
}

QComboBox QAbstractItemView::item {
    min-height: 29px;
    padding: 3px 9px;
}

QCheckBox {
    color: #4e5969;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background: #1677ff;
    border-color: #1677ff;
}

QGroupBox#collapsibleBehaviorGroup {
    background: #ffffff;
    border-color: #e5e6eb;
}

QGroupBox#collapsibleBehaviorGroup::indicator {
    width: 0;
    height: 0;
}

QCheckBox#behaviorTag,
QCheckBox#customBehaviorTag {
    min-height: 24px;
    padding: 5px 10px;
    background: #e8f3ff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1677ff;
}

QCheckBox#customBehaviorTag {
    padding-right: 28px;
}

QCheckBox#behaviorTag:hover,
QCheckBox#customBehaviorTag:hover {
    border-color: #4096ff;
}

QCheckBox#behaviorTag:checked,
QCheckBox#customBehaviorTag:checked {
    background: #1677ff;
    border-color: #1677ff;
    color: #ffffff;
    font-weight: 600;
}

QCheckBox#behaviorTag::indicator,
QCheckBox#customBehaviorTag::indicator {
    width: 0;
    height: 0;
    border: 0;
}

QLabel#historicalBehaviorTag {
    min-height: 24px;
    padding: 5px 10px;
    background: #f2f3f5;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #86909c;
}

QToolButton#customTagDeleteButton {
    min-width: 15px;
    min-height: 15px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 8px;
    color: #1677ff;
    font-size: 11px;
}

QToolButton#customTagDeleteButton:hover {
    background: #ffffff;
    color: #ff7875;
}

QScrollBar:vertical {
    width: 8px;
    margin: 4px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #c9cdd4;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #a9aeb8;
}

QScrollBar:horizontal {
    height: 8px;
    margin: 4px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #c9cdd4;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #a9aeb8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QWidget#tableFilterBar,
QWidget#tableActionBar,
QWidget#videoControlsPanel {
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f7f8fa;
    color: #1f2329;
    gridline-color: #e5e6eb;
    selection-background-color: #e8f3ff;
    selection-color: #1f2329;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 6px 9px;
    border-bottom: 1px solid #f2f3f5;
}

QTableWidget::item:alternate {
    background: #f7f8fa;
}

QTableWidget::item:selected {
    background: #e8f3ff;
    color: #1f2329;
}

QHeaderView::section {
    min-height: 30px;
    background: #f2f3f5;
    color: #4e5969;
    border: 0;
    border-right: 1px solid #e5e6eb;
    border-bottom: 1px solid #e5e6eb;
    padding: 7px 9px;
    font-weight: 700;
}

QSlider::groove:horizontal {
    height: 7px;
    background: #e5e6eb;
    border-radius: 4px;
}

QSlider::sub-page:horizontal,
QProgressBar::chunk {
    background: #1677ff;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background: #ffffff;
    border: 3px solid #1677ff;
    border-radius: 8px;
}

QProgressBar {
    min-height: 22px;
    background: #ffffff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #4e5969;
    text-align: center;
}

QSplitter::handle {
    background: #e5e6eb;
}

QSplitter::handle:hover {
    background: #e8f3ff;
}

QDialogButtonBox {
    border-top: 1px solid #e5e6eb;
    padding-top: 10px;
}

QGraphicsView#videoSurface,
QGraphicsView#videoSurface::viewport {
    background: #1f2329;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
}

QLabel#playbackRateBadge {
    min-width: 42px;
    padding: 5px 8px;
    background: #e8f3ff;
    border: 1px solid #e5e6eb;
    border-radius: 8px;
    color: #1677ff;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}
